# ==============================================================================
# mgr configuration file (mgr.conf)
# ==============================================================================
# Ultra-flexible syntax: Spaces and alignment DO NOT matter.
#
# Supported Formats:
#
# 1. Full Format (with colon or comma separators):
#    api     = my-backend.service : 8000   : Main FastAPI Backend : backend,server
#    db      = mongod.service     : 27017  : MongoDB Database     : mongo
#    cache   = redis-server       : 6379   : Redis Store          : redis
#    proxy   = caddy              : 80,443 : Web Proxy            : web
#
# 2. Simple Key = Value (auto-appends .service, defaults port/desc):
#    api     = my-backend
#    db      = mongod
#    cache   = redis-server
#    proxy   = caddy
#
# 3. Minimal (one service per line):
#    my-backend.service
#    mongod
#    redis-server
#    caddy
#
# 4. INI Section Block Format:
#    [api]
#    unit = my-backend.service
#    port = 8000
#    desc = Main FastAPI Backend
#    alias = backend,app
#
# ==============================================================================

[services]
proxy    = caddy.service        : 80,443 : Caddy Reverse Proxy & SSL : web,caddy
api      = sahibe.service       : 8008   : Sahibe PDKS Backend API   : pdks,sahibe-api
licence  = dagserver.service    : 8085   : DagLicence Server         : dagserver
mailer   = mailhub.service      : 8086   : MailHub Email Engine      : mailhub
mongo    = mongod.service       : 27017  : MongoDB 8.0 Database      : mongod,mongodb
redis    = redis-server.service : 6379   : Redis In-Memory Store     : redis-server
minio    = minio.service        : 9000   : MinIO Object Storage      : s3
postgres = postgresql.service   : 5432   : PostgreSQL Database       : psql,psql-db
