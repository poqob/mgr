#!/usr/bin/env bash
# ==============================================================================
# mgr - Lightweight Systemd Service Manager, MCP Server & Auto-Healing Watchdog
# GitHub: https://github.com/poqob/mgr
# License: MIT
# ==============================================================================

set -eo pipefail

VERSION="1.2.0"

# Colors & Formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

if [[ $EUID -eq 0 ]]; then
    LOG_FILE="/var/log/mgr-watchdog.log"
    CRON_FILE="/etc/cron.d/mgr-watchdog"
else
    LOG_FILE="${HOME}/.local/share/mgr/mgr-watchdog.log"
    CRON_FILE=""
    mkdir -p "${HOME}/.local/share/mgr" 2>/dev/null || true
fi
SYSTEMD_MODE="${MGR_MODE:-auto}"

# Config file search locations (in priority order)
CONFIG_PATHS=(
    "${MGR_CONFIG:-}"
    "./mgr.conf"
    "./mgr.ini"
    "$HOME/.config/mgr/mgr.conf"
    "/etc/mgr/mgr.conf"
    "/etc/mgr.conf"
)

ACTIVE_CONFIG=""
SERVICES=()

# ------------------------------------------------------------------------------
# Flexible & Lenient Configuration Loader
# ------------------------------------------------------------------------------
find_config() {
    for path in "${CONFIG_PATHS[@]}"; do
        if [[ -n "$path" && -f "$path" ]]; then
            ACTIVE_CONFIG="$path"
            return 0
        fi
    done
    return 1
}

load_services() {
    if ! find_config; then
        echo -e "${RED}[ERROR] No configuration file (mgr.conf) found.${NC}" >&2
        echo -e "Run ${BOLD}mgr init${NC} to create a starter configuration file." >&2
        exit 1
    fi

    SERVICES=()
    local current_section=""
    local cur_name=""
    local cur_unit=""
    local cur_port="-"
    local cur_desc=""
    local cur_aliases=""

    flush_ini_service() {
        if [[ -n "$cur_name" && "$current_section" != "config" && "$current_section" != "general" ]]; then
            local unit="${cur_unit:-$cur_name}"
            [[ "$unit" != *.* ]] && unit="${unit}.service"
            SERVICES+=("$cur_name|$unit|${cur_port:--}|${cur_desc:-$cur_name}|$cur_aliases")
            cur_name="" cur_unit="" cur_port="-" cur_desc="" cur_aliases=""
        fi
    }

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Trim leading/trailing whitespace
        line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

        # Skip blank lines or comments
        [[ -z "$line" || "$line" =~ ^[#\;] ]] && continue

        # Handle INI section header [section_name]
        if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\]$ ]]; then
            flush_ini_service
            local sec="${BASH_REMATCH[1]}"
            if [[ "$sec" == "services" ]]; then
                current_section=""
            elif [[ "$sec" == "general" || "$sec" == "config" ]]; then
                current_section="$sec"
                cur_name=""
            else
                current_section="$sec"
                cur_name="$sec"
                cur_unit=""
                cur_port="-"
                cur_desc="$sec"
                cur_aliases=""
            fi
            continue
        fi

        # If inside a named section [my-service] or [config]
        if [[ -n "$current_section" ]]; then
            if [[ "$line" =~ ^([a-zA-Z0-9_-]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
                local k=$(echo "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]')
                local v=$(echo "${BASH_REMATCH[2]}" | xargs)
                if [[ "$current_section" == "config" || "$current_section" == "general" ]]; then
                    case "$k" in
                        mode) SYSTEMD_MODE="$v" ;;
                        log_file|logfile) LOG_FILE="$v" ;;
                    esac
                else
                    case "$k" in
                        unit|service) cur_unit="$v" ;;
                        port|ports) cur_port="$v" ;;
                        desc|description) cur_desc="$v" ;;
                        alias|aliases) cur_aliases="$v" ;;
                    esac
                fi
            fi
            continue
        fi

        # Format A: name = unit : port : description : aliases
        # (Separators can be colon, arbitrary whitespace, or omitted completely!)
        if [[ "$line" =~ ^([a-zA-Z0-9_-]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            local s_name="${BASH_REMATCH[1]}"
            local rest="${BASH_REMATCH[2]}"

            local s_unit=""
            local s_port="-"
            local s_desc=""
            local s_aliases=""

            if [[ "$rest" == *:* ]]; then
                IFS=':' read -r s_unit s_port s_desc s_aliases <<< "$rest"
            elif [[ "$rest" == *,* ]]; then
                IFS=',' read -r s_unit s_port s_desc s_aliases <<< "$rest"
            else
                s_unit="$rest"
            fi

            s_unit=$(echo "${s_unit:-$s_name}" | xargs)
            [[ "$s_unit" != *.* ]] && s_unit="${s_unit}.service"

            s_port=$(echo "${s_port:--}" | xargs)
            [[ -z "$s_port" ]] && s_port="-"

            s_desc=$(echo "${s_desc:-$s_name}" | xargs)
            [[ -z "$s_desc" ]] && s_desc="$s_name"

            s_aliases=$(echo "${s_aliases:-}" | xargs)

            SERVICES+=("$s_name|$s_unit|$s_port|$s_desc|$s_aliases")

        # Format B: simple single-word line (e.g. "mongod" or "caddy.service")
        elif [[ "$line" =~ ^([a-zA-Z0-9_.-]+)$ ]]; then
            local raw="${BASH_REMATCH[1]}"
            local s_name="${raw%.service}"
            local s_unit="$raw"
            [[ "$s_unit" != *.* ]] && s_unit="${s_unit}.service"
            SERVICES+=("$s_name|$s_unit|-|$s_name|")
        fi
    done < "$ACTIVE_CONFIG"

    flush_ini_service

    if [[ ${#SERVICES[@]} -eq 0 ]]; then
        echo -e "${YELLOW}[WARNING] No valid services defined in $ACTIVE_CONFIG${NC}" >&2
    fi
}

resolve_service() {
    local query="$1"
    query=$(echo "$query" | tr '[:upper:]' '[:lower:]')

    for entry in "${SERVICES[@]}"; do
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        local lower_name=$(echo "$s_name" | tr '[:upper:]' '[:lower:]')
        local lower_unit=$(echo "$s_unit" | tr '[:upper:]' '[:lower:]')

        if [[ "$lower_name" == "$query" || "$lower_unit" == "$query" || "${lower_unit%.service}" == "$query" ]]; then
            echo "$s_name"
            return 0
        fi

        # Check aliases
        if [[ -n "$s_aliases" ]]; then
            IFS=',' read -ra alias_arr <<< "$s_aliases"
            for a in "${alias_arr[@]}"; do
                local lower_alias=$(echo "$a" | xargs | tr '[:upper:]' '[:lower:]')
                if [[ "$lower_alias" == "$query" ]]; then
                    echo "$s_name"
                    return 0
                fi
            done
        fi
    done

    echo "$query"
}

get_service_entry() {
    local key="$1"
    for entry in "${SERVICES[@]}"; do
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        if [[ "$s_name" == "$key" ]]; then
            echo "$entry"
            return 0
        fi
    done
    return 1
}

# ------------------------------------------------------------------------------
# Systemd Helpers
# ------------------------------------------------------------------------------
get_sysctl_cmd() {
    local unit="$1"
    if [[ "$SYSTEMD_MODE" == "user" ]]; then
        echo "systemctl --user"
    elif [[ "$SYSTEMD_MODE" == "system" ]]; then
        echo "systemctl"
    elif [[ -f "$HOME/.config/systemd/user/$unit" ]] || systemctl --user status "$unit" &>/dev/null; then
        echo "systemctl --user"
    elif [[ $EUID -ne 0 ]] && ! systemctl is-active --quiet "$unit" 2>/dev/null; then
        echo "systemctl --user"
    else
        echo "systemctl"
    fi
}

get_journctl_cmd() {
    local unit="$1"
    local s_cmd=$(get_sysctl_cmd "$unit")
    if [[ "$s_cmd" == *"user"* ]]; then
        echo "journalctl --user-unit=$unit"
    else
        echo "journalctl -u $unit"
    fi
}

get_memory_mb() {
    local unit="$1"
    local s_ctl=$(get_sysctl_cmd "$unit")
    local mem
    mem=$($s_ctl show "$unit" --property=MemoryCurrent 2>/dev/null | cut -d= -f2)
    if [[ -n "$mem" && "$mem" != "[not set]" && "$mem" != "18446744073709551615" && "$mem" -gt 0 ]] 2>/dev/null; then
        echo "$((mem / 1024 / 1024))"
        return 0
    fi

    # Fallback to PID + children RSS
    local pid=$(get_pid "$unit")
    if [[ -n "$pid" && "$pid" -gt 0 ]] 2>/dev/null; then
        local all_pids=$( (echo "$pid"; pgrep -P "$pid" 2>/dev/null) | tr '\n' ',' | sed 's/,$//')
        local total_rss=$(ps -o rss= -p "$all_pids" 2>/dev/null | awk '{s+=$1} END {print s}' || echo "0")
        if [[ -n "$total_rss" && "$total_rss" -gt 0 ]] 2>/dev/null; then
            echo "$((total_rss / 1024))"
            return 0
        fi
    fi

    echo "0"
}

get_pid() {
    local unit="$1"
    local s_ctl=$(get_sysctl_cmd "$unit")
    local pid
    pid=$($s_ctl show "$unit" --property=MainPID 2>/dev/null | cut -d= -f2)
    if [[ -z "$pid" || "$pid" -eq 0 ]] 2>/dev/null; then
        echo "0"
    else
        echo "$pid"
    fi
}

check_service_health() {
    local name="$1"
    local unit="$2"
    local port="$3"

    # Specific deep probe for Cloudflare Tunnel
    if [[ "$name" == "tunnel" || "$unit" == *"cloudflared"* ]]; then
        local resp=$(curl -fsS -m 2 "http://127.0.0.1:20241/ready" 2>/dev/null || true)
        local ready_conns=$(echo "$resp" | grep -o '"readyConnections":[0-9]*' | cut -d: -f2 || echo "0")
        if [[ "$resp" == *'"status":200'* && "${ready_conns:-0}" -gt 0 ]]; then
            return 0
        else
            return 1
        fi
    fi

    return 0
}

# ------------------------------------------------------------------------------
# JSON Generation Engine
# ------------------------------------------------------------------------------
generate_json_status() {
    local auto_heal="${1:-false}"
    local json_services="["
    local first=true

    for entry in "${SERVICES[@]}"; do
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        local status="DEAD"
        local pid=0
        local mem_mb=0
        local s_ctl=$(get_sysctl_cmd "$s_unit")

        if $s_ctl is-active --quiet "$s_unit"; then
            if ! check_service_health "$s_name" "$s_unit" "$s_port"; then
                if [[ "$auto_heal" == "true" ]]; then
                    $s_ctl --no-ask-password restart "$s_unit" >/dev/null 2>&1 || true
                    sleep 0.8
                    if $s_ctl is-active --quiet "$s_unit" && check_service_health "$s_name" "$s_unit" "$s_port"; then
                        status="RECOVERED"
                        echo "$(date '+%Y-%m-%d %H:%M:%S') [AUTO-HEAL] Recovered degraded service: $s_name ($s_unit)" >> "$LOG_FILE" 2>/dev/null || true
                    else
                        status="DEGRADED"
                    fi
                else
                    status="DEGRADED"
                fi
            else
                status="RUNNING"
            fi
            pid=$(get_pid "$s_unit")
            mem_mb=$(get_memory_mb "$s_unit")
        else
            if [[ "$auto_heal" == "true" ]]; then
                $s_ctl --no-ask-password restart "$s_unit" >/dev/null 2>&1 || true
                sleep 0.4
                if $s_ctl is-active --quiet "$s_unit"; then
                    status="RECOVERED"
                    pid=$(get_pid "$s_unit")
                    mem_mb=$(get_memory_mb "$s_unit")
                    echo "$(date '+%Y-%m-%d %H:%M:%S') [AUTO-HEAL] Recovered crashed service: $s_name ($s_unit)" >> "$LOG_FILE" 2>/dev/null || true
                else
                    status="FAILED"
                fi
            fi
        fi

        [[ "$first" == "true" ]] && first=false || json_services+=","
        json_services+="{\"name\":\"$s_name\",\"unit\":\"$s_unit\",\"status\":\"$status\",\"pid\":$pid,\"memory_mb\":$mem_mb,\"port\":\"$s_port\",\"description\":\"$s_desc\"}"
    done
    json_services+="]"

    local free_ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $7}' || echo "N/A")
    local total_ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $2}' || echo "N/A")
    local used_ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $3}' || echo "N/A")

    cat << EOF
{
  "config": "$ACTIVE_CONFIG",
  "services": $json_services,
  "system_memory": {
    "used": "$used_ram",
    "total": "$total_ram",
    "available": "$free_ram"
  }
}
EOF
}

# ------------------------------------------------------------------------------
# CLI Actions
# ------------------------------------------------------------------------------
cmd_status_check() {
    local auto_heal="$1"
    local silent="$2"
    local json_output="$3"

    if [[ "$json_output" == "true" ]]; then
        generate_json_status "$auto_heal"
        return 0
    fi

    if [[ "$silent" != "true" ]]; then
        echo -e "${BOLD}${CYAN}========================================================================${NC}"
        echo -e "${BOLD}${CYAN}           mgr - Services Status & Health Overview                      ${NC}"
        echo -e "${DIM}  Config: ${ACTIVE_CONFIG}${NC}"
        echo -e "${BOLD}${CYAN}========================================================================${NC}"
        printf "%-14s %-12s %-8s %-10s %-10s %-22s\n" "SERVICE" "STATUS" "PID" "MEMORY" "PORT" "DESCRIPTION"
        echo "------------------------------------------------------------------------"
    fi

    for entry in "${SERVICES[@]}"; do
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        local status="DEAD"
        local color="$RED"
        local pid="-"
        local mem="-"

        local s_ctl=$(get_sysctl_cmd "$s_unit")

        if $s_ctl is-active --quiet "$s_unit"; then
            if ! check_service_health "$s_name" "$s_unit" "$s_port"; then
                if [[ "$auto_heal" == "true" ]]; then
                    $s_ctl --no-ask-password restart "$s_unit" >/dev/null 2>&1 || true
                    sleep 0.8
                    if $s_ctl is-active --quiet "$s_unit" && check_service_health "$s_name" "$s_unit" "$s_port"; then
                        status="RECOVERED"
                        color="$YELLOW"
                        echo "$(date '+%Y-%m-%d %H:%M:%S') [AUTO-HEAL] Recovered degraded service: $s_name ($s_unit)" >> "$LOG_FILE" 2>/dev/null || true
                    else
                        status="DEGRADED"
                        color="$YELLOW"
                    fi
                else
                    status="DEGRADED"
                    color="$YELLOW"
                fi
            else
                status="RUNNING"
                color="$GREEN"
            fi
            pid=$(get_pid "$s_unit")
            local mb=$(get_memory_mb "$s_unit")
            [[ "$mb" -gt 0 ]] && mem="${mb}MB" || mem="-"
        else
            if [[ "$auto_heal" == "true" ]]; then
                $s_ctl --no-ask-password restart "$s_unit" >/dev/null 2>&1 || true
                sleep 0.4
                if $s_ctl is-active --quiet "$s_unit"; then
                    status="RECOVERED"
                    color="$YELLOW"
                    pid=$(get_pid "$s_unit")
                    local mb=$(get_memory_mb "$s_unit")
                    [[ "$mb" -gt 0 ]] && mem="${mb}MB" || mem="-"
                    echo "$(date '+%Y-%m-%d %H:%M:%S') [AUTO-HEAL] Recovered crashed service: $s_name ($s_unit)" >> "$LOG_FILE" 2>/dev/null || true
                else
                    status="FAILED"
                    color="$RED"
                    echo "$(date '+%Y-%m-%d %H:%M:%S') [ALERT] Failed to start service: $s_name ($s_unit)" >> "$LOG_FILE" 2>/dev/null || true
                fi
            fi
        fi

        if [[ "$silent" != "true" ]]; then
            printf "%-14s ${color}%-12s${NC} %-8s %-10s %-10s %-22s\n" "$s_name" "$status" "$pid" "$mem" "$s_port" "$s_desc"
        fi
    done

    if [[ "$silent" != "true" ]]; then
        echo -e "${BOLD}${CYAN}========================================================================${NC}"
        local free_ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $7}' || echo "N/A")
        local total_ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $2}' || echo "N/A")
        local used_ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $3}' || echo "N/A")
        echo -e "${BOLD}System Memory:${NC} Used: ${used_ram} / Total: ${total_ram} (Available: ${free_ram})"
        echo ""
    fi
}

cmd_start_or_restart() {
    local json_output="false"
    local target_services=()
    for arg in "$@"; do
        [[ -z "$arg" ]] && continue
        if [[ "$arg" == "--json" || "$arg" == "-j" ]]; then
            json_output="true"
        else
            target_services+=("$arg")
        fi
    done

    if [[ ${#target_services[@]} -eq 0 ]]; then
        [[ "$json_output" != "true" ]] && echo -e "${YELLOW}Restarting all registered services in ${ACTIVE_CONFIG}...${NC}"
        for entry in "${SERVICES[@]}"; do
            IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
            [[ "$json_output" != "true" ]] && echo -e "  -> Restarting ${BOLD}$s_name${NC} ($s_unit)..."
            local s_ctl=$(get_sysctl_cmd "$s_unit")
            $s_ctl restart "$s_unit"
        done
    else
        for t in "${target_services[@]}"; do
            local resolved=$(resolve_service "$t")
            local entry=$(get_service_entry "$resolved" || true)
            if [[ -n "$entry" ]]; then
                IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
                [[ "$json_output" != "true" ]] && echo -e "  -> Starting / Restarting ${BOLD}$s_name${NC} ($s_unit)..."
                local s_ctl=$(get_sysctl_cmd "$s_unit")
                $s_ctl restart "$s_unit"
            else
                [[ "$json_output" != "true" ]] && echo -e "  ${RED}[!] Unknown service: $t${NC}"
            fi
        done
    fi

    [[ "$json_output" != "true" ]] && echo ""
    cmd_status_check false false "$json_output"
}

cmd_stop() {
    local json_output="false"
    local target_services=()
    for arg in "$@"; do
        [[ -z "$arg" ]] && continue
        if [[ "$arg" == "--json" || "$arg" == "-j" ]]; then
            json_output="true"
        else
            target_services+=("$arg")
        fi
    done

    if [[ ${#target_services[@]} -eq 0 ]]; then
        [[ "$json_output" != "true" ]] && echo -e "${RED}Stopping all registered services in ${ACTIVE_CONFIG}...${NC}"
        for entry in "${SERVICES[@]}"; do
            IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
            [[ "$json_output" != "true" ]] && echo -e "  -> Stopping ${BOLD}$s_name${NC} ($s_unit)..."
            local s_ctl=$(get_sysctl_cmd "$s_unit")
            $s_ctl stop "$s_unit"
        done
    else
        for t in "${target_services[@]}"; do
            local resolved=$(resolve_service "$t")
            local entry=$(get_service_entry "$resolved" || true)
            if [[ -n "$entry" ]]; then
                IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
                [[ "$json_output" != "true" ]] && echo -e "  -> Stopping ${BOLD}$s_name${NC} ($s_unit)..."
                local s_ctl=$(get_sysctl_cmd "$s_unit")
                $s_ctl stop "$s_unit"
            else
                [[ "$json_output" != "true" ]] && echo -e "  ${RED}[!] Unknown service: $t${NC}"
            fi
        done
    fi

    [[ "$json_output" != "true" ]] && echo ""
    cmd_status_check false false "$json_output"
}

cmd_kill() {
    local json_output="false"
    local target_services=()
    for arg in "$@"; do
        [[ -z "$arg" ]] && continue
        if [[ "$arg" == "--json" || "$arg" == "-j" ]]; then
            json_output="true"
        else
            target_services+=("$arg")
        fi
    done

    if [[ ${#target_services[@]} -eq 0 ]]; then
        [[ "$json_output" != "true" ]] && echo -e "${RED}Force killing all registered services...${NC}"
        for entry in "${SERVICES[@]}"; do
            IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
            [[ "$json_output" != "true" ]] && echo -e "  -> Killing ${BOLD}$s_name${NC} ($s_unit)..."
            local s_ctl=$(get_sysctl_cmd "$s_unit")
            $s_ctl kill -s SIGKILL "$s_unit" 2>/dev/null || true
            $s_ctl stop "$s_unit" 2>/dev/null || true
        done
    else
        for t in "${target_services[@]}"; do
            local resolved=$(resolve_service "$t")
            local entry=$(get_service_entry "$resolved" || true)
            if [[ -n "$entry" ]]; then
                IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
                [[ "$json_output" != "true" ]] && echo -e "  -> Killing ${BOLD}$s_name${NC} ($s_unit)..."
                local s_ctl=$(get_sysctl_cmd "$s_unit")
                $s_ctl kill -s SIGKILL "$s_unit" 2>/dev/null || true
                $s_ctl stop "$s_unit" 2>/dev/null || true
            else
                [[ "$json_output" != "true" ]] && echo -e "  ${RED}[!] Unknown service: $t${NC}"
            fi
        done
    fi

    [[ "$json_output" != "true" ]] && echo ""
    cmd_status_check false false "$json_output"
}

cmd_logs() {
    local target="$1"
    local lines="${2:-50}"
    local json_output="false"

    if [[ "$3" == "--json" || "$3" == "-j" || "$target" == "--json" ]]; then
        json_output="true"
    fi

    if [[ -z "$target" || "$target" == "--json" ]]; then
        echo -e "${YELLOW}Usage: mgr logs <service_name> [lines]${NC}" >&2
        exit 1
    fi

    local resolved=$(resolve_service "$target")
    local entry=$(get_service_entry "$resolved" || true)
    if [[ -n "$entry" ]]; then
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        local j_ctl=$(get_journctl_cmd "$s_unit")
        if [[ "$json_output" == "true" ]]; then
            local logs_content=$($j_ctl -n "$lines" --no-pager 2>/dev/null | python3 -c 'import sys, json; print(json.dumps(sys.stdin.read()))' 2>/dev/null || echo '""')
            echo "{\"service\": \"$s_name\", \"unit\": \"$s_unit\", \"lines\": $lines, \"logs\": $logs_content}"
        else
            echo -e "${CYAN}Streaming live logs for ${BOLD}$s_name${NC} ($s_unit)... (Press Ctrl+C to exit)${NC}"
            $j_ctl -n "$lines" -f
        fi
    else
        echo -e "${RED}[!] Unknown service: $target${NC}" >&2
        exit 1
    fi
}

cmd_init() {
    local target_file="./mgr.conf"
    if [[ -f "$target_file" ]]; then
        echo -e "${YELLOW}mgr.conf already exists in current directory.${NC}"
        exit 0
    fi

    cat << 'EOF' > "$target_file"
# ==============================================================================
# mgr configuration file (mgr.conf)
# ==============================================================================
# Simple, flexible syntax. Examples:
#
#   api      = my-backend.service : 8000   : FastAPI Main Backend : backend,server
#   db       = mongod.service     : 27017  : MongoDB Database     : mongo
#   cache    = redis-server       : 6379   : Redis Store          : redis
#   proxy    = caddy              : 80,443 : Web Proxy            : web
#
# Even simpler:
#   my-app   = my-app.service
#   nginx
# ==============================================================================

[services]
caddy      = caddy.service        : 80,443   : Caddy Reverse Proxy & SSL : web,proxy
api        = my-backend.service   : 8000     : Primary REST API          : backend,app
redis      = redis-server.service : 6379     : Redis Cache Store         : cache
postgres   = postgresql.service   : 5432     : PostgreSQL Database       : db,psql
EOF

    echo -e "${GREEN}✓ Created starter configuration at ${BOLD}$target_file${NC}"
    echo "Edit this file to list your services, then run 'mgr' to manage them."
}

cmd_install_watchdog() {
    local mgr_bin=$(command -v mgr || echo "$HOME/.local/bin/mgr")
    if [[ $EUID -eq 0 ]]; then
        cat << EOF > "$CRON_FILE"
* * * * * root $mgr_bin -w >/dev/null 2>&1
EOF
        chmod 644 "$CRON_FILE"
        echo -e "${GREEN}✓ Watchdog cron job installed at $CRON_FILE (runs every 1 minute).${NC}"
        echo -e "Logs will be written to ${BOLD}$LOG_FILE${NC} when services auto-recover."
    else
        (crontab -l 2>/dev/null | grep -v "$mgr_bin -w" || true; echo "* * * * * $mgr_bin -w >/dev/null 2>&1") | crontab -
        echo -e "${GREEN}✓ User watchdog cron job installed in crontab (runs every 1 minute).${NC}"
        echo -e "Logs will be written to ${BOLD}$LOG_FILE${NC} when services auto-recover."
    fi
}

cmd_uninstall_watchdog() {
    local mgr_bin=$(command -v mgr || echo "$HOME/.local/bin/mgr")
    if [[ $EUID -eq 0 ]]; then
        rm -f "$CRON_FILE"
        echo -e "${GREEN}✓ Watchdog cron job removed from $CRON_FILE.${NC}"
    else
        (crontab -l 2>/dev/null | grep -v "$mgr_bin -w" || true) | crontab -
        echo -e "${GREEN}✓ User watchdog cron job removed from crontab.${NC}"
    fi
}

cmd_list_services() {
    load_services 2>/dev/null || true
    local items=()
    for entry in "${SERVICES[@]}"; do
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        items+=("$s_name")
        if [[ -n "$s_aliases" ]]; then
            IFS=',' read -ra alias_arr <<< "$s_aliases"
            for a in "${alias_arr[@]}"; do
                local clean_a=$(echo "$a" | xargs)
                [[ -n "$clean_a" ]] && items+=("$clean_a")
            done
        fi
    done
    printf "%s\n" "${items[@]}" | awk '!seen[$0]++' | tr '\n' ' '
    echo ""
}

cmd_completion() {
    local shell="${1:-bash}"
    case "$shell" in
        bash)
            cat << 'EOF'
# bash completion for mgr
_mgr() {
    local cur prev words cword
    if declare -F _init_completion >/dev/null 2>&1; then
        _init_completion || return
    else
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
        words=("${COMP_WORDS[@]}")
        cword=$COMP_CWORD
    fi

    local commands="up start down stop restart kill logs watchdog mcp init install-watchdog uninstall-watchdog install-completion completion version help check status"
    local flags="--json -j --help -h --version -v"

    local services
    services=$(mgr --list-services 2>/dev/null)

    case "$prev" in
        logs|-l)
            COMPREPLY=( $(compgen -W "$services" -- "$cur") )
            return 0
            ;;
        restart|-r|start|up|stop|-s|down|kill|-k)
            COMPREPLY=( $(compgen -W "$services" -- "$cur") )
            return 0
            ;;
        completion)
            COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
            return 0
            ;;
    esac

    # First argument completion
    if [[ $cword -eq 1 ]]; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
        else
            COMPREPLY=( $(compgen -W "$commands $services" -- "$cur") )
        fi
        return 0
    fi

    # Subsequent arguments for multi-service actions
    local first_cmd="${words[1]}"
    case "$first_cmd" in
        restart|-r|start|up|stop|-s|down|kill|-k)
            COMPREPLY=( $(compgen -W "$services" -- "$cur") )
            return 0
            ;;
        logs|-l)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$services" -- "$cur") )
            elif [[ $cword -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "10 20 50 100 200 500" -- "$cur") )
            fi
            return 0
            ;;
    esac

    COMPREPLY=( $(compgen -W "$services" -- "$cur") )
}
complete -F _mgr mgr
EOF
            ;;
        zsh)
            cat << 'EOF'
#compdef mgr

_mgr() {
    local -a commands
    commands=(
        'start:Start or restart services'
        'stop:Stop services'
        'restart:Restart services'
        'kill:Force kill services'
        'logs:Tail service logs'
        'status:Show status overview'
        'watchdog:Run auto-healing watchdog check'
        'mcp:Start Model Context Protocol server'
        'init:Create a starter mgr.conf'
        'install-watchdog:Install cron watchdog'
        'uninstall-watchdog:Remove cron watchdog'
        'install-completion:Install shell tab-completion'
        'completion:Generate shell completion script'
        'version:Show version'
        'help:Show help'
    )

    local -a services
    services=(${(f)"$(mgr --list-services 2>/dev/null | tr ' ' '\n')"})

    _arguments -C \
        '(-j --json)'{-j,--json}'[Output structured JSON]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-v --version)'{-v,--version}'[Show version]' \
        '1: :->cmd' \
        '*:: :->args'

    case $state in
        cmd)
            _describe -t commands 'mgr command' commands
            _values 'services' $services
            ;;
        args)
            case $words[1] in
                restart|-r|start|up|stop|-s|down|kill|-k)
                    _values 'services' $services
                    ;;
                logs|-l)
                    _values 'services' $services
                    ;;
            esac
            ;;
    esac
}

_mgr "$@"
EOF
            ;;
        *)
            echo "Unsupported shell: $shell (supported: bash, zsh)" >&2
            return 1
            ;;
    esac
}

cmd_install_completion() {
    local target_dir="${HOME}/.local/share/bash-completion/completions"
    mkdir -p "$target_dir"
    cmd_completion bash > "$target_dir/mgr"
    echo -e "${GREEN}✓ Bash completion script installed to ${BOLD}$target_dir/mgr${NC}"

    # Also register in ~/.bashrc if not already present
    if ! grep -q "bash-completion/completions/mgr" "${HOME}/.bashrc" 2>/dev/null; then
        echo -e "\n# mgr bash completion\n[ -f \"\$HOME/.local/share/bash-completion/completions/mgr\" ] && source \"\$HOME/.local/share/bash-completion/completions/mgr\"" >> "${HOME}/.bashrc"
    fi

    echo -e "${GREEN}✓ Registered completion in ${BOLD}~/.bashrc${NC}"
    echo -e "${CYAN}Run: ${BOLD}source ~/.bashrc${NC} or open a new terminal session to use tab completion immediately!${NC}"
}

# ------------------------------------------------------------------------------
# Model Context Protocol (MCP) Server Handler (JSON-RPC 2.0 over stdio)
# ------------------------------------------------------------------------------
cmd_mcp_server() {
    load_services

    if ! command -v python3 >/dev/null 2>&1; then
        echo -e "${RED}[ERROR] python3 is required to run the stdio MCP server.${NC}" >&2
        exit 1
    fi

    read -r -d '' MCP_PY_SCRIPT << 'PYEOF' || true
import sys
import json
import subprocess
import os

MGR_EXEC = os.environ.get("MGR_PATH", "mgr")

TOOLS = [
    {
        "name": "list_services",
        "description": "Returns the live status, PID, memory usage (MB), ports, and descriptions of all system services managed by mgr.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "auto_heal": {
                    "type": "boolean",
                    "description": "If true, automatically restart any dead or crashed services."
                }
            }
        }
    },
    {
        "name": "restart_service",
        "description": "Restarts a specific service (or all services if no service name is specified).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "description": "The short name or alias of the service (e.g. 'api', 'db', 'caddy'). Leave empty to restart all."
                }
            }
        }
    },
    {
        "name": "stop_service",
        "description": "Gracefully stops a specific service (or all services if omitted).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "description": "The service name or alias to stop."
                }
            }
        }
    },
    {
        "name": "kill_service",
        "description": "Forcefully terminates (SIGKILL) a service process.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "description": "The service name to force-kill."
                }
            }
        }
    },
    {
        "name": "get_service_logs",
        "description": "Fetches the recent systemd/journalctl logs for a specific service.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "description": "The service name to fetch logs for."
                },
                "lines": {
                    "type": "integer",
                    "description": "Number of log lines to retrieve (default: 50)."
                }
            },
            "required": ["service"]
        }
    },
    {
        "name": "auto_heal_services",
        "description": "Scans all registered services and automatically restarts any crashed or inactive services.",
        "inputSchema": {
            "type": "object",
            "properties": {}
        }
    }
]

def run_mgr_json(args):
    cmd = [MGR_EXEC] + args + ["--json"]
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=True)
        return json.loads(res.stdout)
    except Exception as e:
        return {"error": str(e), "raw": res.stderr if 'res' in locals() else ""}

def handle_request(req):
    req_id = req.get("id")
    method = req.get("method")
    params = req.get("params", {})

    if method == "initialize":
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "protocolVersion": "2024-11-05",
                "capabilities": {
                    "tools": {}
                },
                "serverInfo": {
                    "name": "mgr-mcp-server",
                    "version": "1.1.0"
                }
            }
        }

    elif method == "notifications/initialized":
        return None

    elif method == "tools/list":
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "tools": TOOLS
            }
        }

    elif method == "tools/call":
        tool_name = params.get("name")
        arguments = params.get("arguments", {})

        if tool_name == "list_services":
            auto_heal = arguments.get("auto_heal", False)
            data = run_mgr_json(["--check"] if not auto_heal else [])
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(data, indent=2)}]
                }
            }

        elif tool_name == "restart_service":
            srv = arguments.get("service", "")
            cmd_args = ["-r"]
            if srv:
                cmd_args.append(srv)
            data = run_mgr_json(cmd_args)
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(data, indent=2)}]
                }
            }

        elif tool_name == "stop_service":
            srv = arguments.get("service", "")
            cmd_args = ["-s"]
            if srv:
                cmd_args.append(srv)
            data = run_mgr_json(cmd_args)
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(data, indent=2)}]
                }
            }

        elif tool_name == "kill_service":
            srv = arguments.get("service", "")
            cmd_args = ["-k"]
            if srv:
                cmd_args.append(srv)
            data = run_mgr_json(cmd_args)
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(data, indent=2)}]
                }
            }

        elif tool_name == "get_service_logs":
            srv = arguments.get("service", "")
            lines = str(arguments.get("lines", 50))
            try:
                res = subprocess.run([MGR_EXEC, "logs", srv, lines, "--json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                data = json.loads(res.stdout) if res.stdout.strip().startswith("{") else {"raw_logs": res.stdout}
            except Exception as e:
                data = {"error": str(e)}
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(data, indent=2)}]
                }
            }

        elif tool_name == "auto_heal_services":
            data = run_mgr_json([])
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(data, indent=2)}]
                }
            }

        else:
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "error": {"code": -32601, "message": f"Unknown tool: {tool_name}"}
            }

    elif method == "ping":
        return {"jsonrpc": "2.0", "id": req_id, "result": {}}

    else:
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "error": {"code": -32601, "message": f"Method not found: {method}"}
        }

def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
            resp = handle_request(req)
            if resp is not None:
                sys.stdout.write(json.dumps(resp) + "\n")
                sys.stdout.flush()
        except Exception as e:
            err_resp = {
                "jsonrpc": "2.0",
                "id": None,
                "error": {"code": -32700, "message": f"Parse error: {str(e)}"}
            }
            sys.stdout.write(json.dumps(err_resp) + "\n")
            sys.stdout.flush()

if __name__ == "__main__":
    main()
PYEOF

    python3 -c "$MCP_PY_SCRIPT"
}

