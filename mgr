#!/usr/bin/env bash
# ==============================================================================
# mgr - Lightweight Systemd Service Manager & Auto-Healing Watchdog
# GitHub: https://github.com/poqob/mgr
# License: MIT
# ==============================================================================

set -eo pipefail

VERSION="1.0.0"

# Colors & Formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

# Default log file for watchdog
LOG_FILE="/var/log/mgr-watchdog.log"
CRON_FILE="/etc/cron.d/mgr-watchdog"

# Config file search locations (in priority order)
CONFIG_PATHS=(
    "${MGR_CONFIG:-}"
    "./mgr.conf"
    "$HOME/.config/mgr/mgr.conf"
    "/etc/mgr/mgr.conf"
    "/etc/mgr.conf"
)

ACTIVE_CONFIG=""
SERVICES=()

# ------------------------------------------------------------------------------
# Configuration Loader
# ------------------------------------------------------------------------------
find_config() {
    for path in "${CONFIG_PATHS[@]}"; do
        if [[ -n "$path" && -f "$path" ]]; then
            ACTIVE_CONFIG="$path"
            return 0
        fi
    done
    return 1
}

load_services() {
    if ! find_config; then
        echo -e "${RED}[ERROR] No configuration file (mgr.conf) found.${NC}"
        echo -e "Run ${BOLD}mgr init${NC} to create a starter configuration file."
        exit 1
    fi

    SERVICES=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Trim leading/trailing whitespace
        line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

        # Skip empty lines, comments, and section headers like [services]
        [[ -z "$line" || "$line" =~ ^[#\;] || "$line" =~ ^\[.*\] ]] && continue

        # Format: name = service.unit : port : description : aliases (optional)
        if [[ "$line" =~ ^([a-zA-Z0-9_-]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            local s_name="${BASH_REMATCH[1]}"
            local rest="${BASH_REMATCH[2]}"

            local s_unit=""
            local s_port="-"
            local s_desc=""
            local s_aliases=""

            IFS=':' read -r s_unit s_port s_desc s_aliases <<< "$rest"

            s_unit=$(echo "${s_unit:-$s_name}" | xargs)
            s_port=$(echo "${s_port:--}" | xargs)
            s_desc=$(echo "${s_desc:-$s_name}" | xargs)
            s_aliases=$(echo "${s_aliases:-}" | xargs)

            SERVICES+=("$s_name|$s_unit|$s_port|$s_desc|$s_aliases")
        fi
    done < "$ACTIVE_CONFIG"

    if [[ ${#SERVICES[@]} -eq 0 ]]; then
        echo -e "${YELLOW}[WARNING] No valid services defined in $ACTIVE_CONFIG${NC}"
    fi
}

resolve_service() {
    local query="$1"
    query=$(echo "$query" | tr '[:upper:]' '[:lower:]')

    for entry in "${SERVICES[@]}"; do
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        local lower_name=$(echo "$s_name" | tr '[:upper:]' '[:lower:]')
        local lower_unit=$(echo "$s_unit" | tr '[:upper:]' '[:lower:]')

        if [[ "$lower_name" == "$query" || "$lower_unit" == "$query" ]]; then
            echo "$s_name"
            return 0
        fi

        # Check aliases
        if [[ -n "$s_aliases" ]]; then
            IFS=',' read -ra alias_arr <<< "$s_aliases"
            for a in "${alias_arr[@]}"; do
                local lower_alias=$(echo "$a" | xargs | tr '[:upper:]' '[:lower:]')
                if [[ "$lower_alias" == "$query" ]]; then
                    echo "$s_name"
                    return 0
                fi
            done
        fi
    done

    echo "$query"
}

get_service_entry() {
    local key="$1"
    for entry in "${SERVICES[@]}"; do
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        if [[ "$s_name" == "$key" ]]; then
            echo "$entry"
            return 0
        fi
    done
    return 1
}

# ------------------------------------------------------------------------------
# Systemd Helpers
# ------------------------------------------------------------------------------
get_memory() {
    local unit="$1"
    local mem
    mem=$(systemctl show "$unit" --property=MemoryCurrent 2>/dev/null | cut -d= -f2)
    if [[ -z "$mem" || "$mem" == "[not set]" || "$mem" == "18446744073709551615" || "$mem" -eq 0 ]] 2>/dev/null; then
        echo "-"
    else
        local mb=$((mem / 1024 / 1024))
        echo "${mb}MB"
    fi
}

get_pid() {
    local unit="$1"
    local pid
    pid=$(systemctl show "$unit" --property=MainPID 2>/dev/null | cut -d= -f2)
    if [[ -z "$pid" || "$pid" -eq 0 ]] 2>/dev/null; then
        echo "-"
    else
        echo "$pid"
    fi
}

# ------------------------------------------------------------------------------
# CLI Actions
# ------------------------------------------------------------------------------
cmd_status_check() {
    local auto_heal="$1"
    local silent="$2"

    if [[ "$silent" != "true" ]]; then
        echo -e "${BOLD}${CYAN}========================================================================${NC}"
        echo -e "${BOLD}${CYAN}           mgr - Services Status & Health Overview                      ${NC}"
        echo -e "${DIM}  Config: ${ACTIVE_CONFIG}${NC}"
        echo -e "${BOLD}${CYAN}========================================================================${NC}"
        printf "%-14s %-12s %-8s %-10s %-10s %-22s\n" "SERVICE" "STATUS" "PID" "MEMORY" "PORT" "DESCRIPTION"
        echo "------------------------------------------------------------------------"
    fi

    local has_crashed=0

    for entry in "${SERVICES[@]}"; do
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        local status="DEAD"
        local color="$RED"
        local pid="-"
        local mem="-"

        if systemctl is-active --quiet "$s_unit"; then
            status="RUNNING"
            color="$GREEN"
            pid=$(get_pid "$s_unit")
            mem=$(get_memory "$s_unit")
        else
            has_crashed=1
            if [[ "$auto_heal" == "true" ]]; then
                systemctl restart "$s_unit" >/dev/null 2>&1 || true
                sleep 0.4
                if systemctl is-active --quiet "$s_unit"; then
                    status="RECOVERED"
                    color="$YELLOW"
                    pid=$(get_pid "$s_unit")
                    mem=$(get_memory "$s_unit")
                    echo "$(date '+%Y-%m-%d %H:%M:%S') [AUTO-HEAL] Recovered crashed service: $s_name ($s_unit)" >> "$LOG_FILE" 2>/dev/null || true
                else
                    status="FAILED"
                    color="$RED"
                    echo "$(date '+%Y-%m-%d %H:%M:%S') [ALERT] Failed to start service: $s_name ($s_unit)" >> "$LOG_FILE" 2>/dev/null || true
                fi
            fi
        fi

        if [[ "$silent" != "true" ]]; then
            printf "%-14s ${color}%-12s${NC} %-8s %-10s %-10s %-22s\n" "$s_name" "$status" "$pid" "$mem" "$s_port" "$s_desc"
        fi
    done

    if [[ "$silent" != "true" ]]; then
        echo -e "${BOLD}${CYAN}========================================================================${NC}"
        local free_ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $7}' || echo "N/A")
        local total_ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $2}' || echo "N/A")
        local used_ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $3}' || echo "N/A")
        echo -e "${BOLD}System Memory:${NC} Used: ${used_ram} / Total: ${total_ram} (Available: ${free_ram})"
        echo ""
    fi
}

cmd_start_or_restart() {
    local target_services=("$@")
    if [[ ${#target_services[@]} -eq 0 ]]; then
        echo -e "${YELLOW}Restarting all registered services in ${ACTIVE_CONFIG}...${NC}"
        for entry in "${SERVICES[@]}"; do
            IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
            echo -e "  -> Restarting ${BOLD}$s_name${NC} ($s_unit)..."
            systemctl restart "$s_unit"
        done
    else
        for t in "${target_services[@]}"; do
            local resolved=$(resolve_service "$t")
            local entry=$(get_service_entry "$resolved" || true)
            if [[ -n "$entry" ]]; then
                IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
                echo -e "  -> Starting / Restarting ${BOLD}$s_name${NC} ($s_unit)..."
                systemctl restart "$s_unit"
            else
                echo -e "  ${RED}[!] Unknown service: $t${NC}"
            fi
        done
    fi
    echo ""
    cmd_status_check false false
}

cmd_stop() {
    local target_services=("$@")
    if [[ ${#target_services[@]} -eq 0 ]]; then
        echo -e "${RED}Stopping all registered services in ${ACTIVE_CONFIG}...${NC}"
        for entry in "${SERVICES[@]}"; do
            IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
            echo -e "  -> Stopping ${BOLD}$s_name${NC} ($s_unit)..."
            systemctl stop "$s_unit"
        done
    else
        for t in "${target_services[@]}"; do
            local resolved=$(resolve_service "$t")
            local entry=$(get_service_entry "$resolved" || true)
            if [[ -n "$entry" ]]; then
                IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
                echo -e "  -> Stopping ${BOLD}$s_name${NC} ($s_unit)..."
                systemctl stop "$s_unit"
            else
                echo -e "  ${RED}[!] Unknown service: $t${NC}"
            fi
        done
    fi
    echo ""
    cmd_status_check false false
}

cmd_kill() {
    local target_services=("$@")
    if [[ ${#target_services[@]} -eq 0 ]]; then
        echo -e "${RED}Force killing all registered services...${NC}"
        for entry in "${SERVICES[@]}"; do
            IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
            echo -e "  -> Killing ${BOLD}$s_name${NC} ($s_unit)..."
            systemctl kill -s SIGKILL "$s_unit" 2>/dev/null || true
            systemctl stop "$s_unit" 2>/dev/null || true
        done
    else
        for t in "${target_services[@]}"; do
            local resolved=$(resolve_service "$t")
            local entry=$(get_service_entry "$resolved" || true)
            if [[ -n "$entry" ]]; then
                IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
                echo -e "  -> Killing ${BOLD}$s_name${NC} ($s_unit)..."
                systemctl kill -s SIGKILL "$s_unit" 2>/dev/null || true
                systemctl stop "$s_unit" 2>/dev/null || true
            else
                echo -e "  ${RED}[!] Unknown service: $t${NC}"
            fi
        done
    fi
    echo ""
    cmd_status_check false false
}

cmd_logs() {
    local target="$1"
    if [[ -z "$target" ]]; then
        echo -e "${YELLOW}Usage: mgr logs <service_name>${NC}"
        echo "Registered services in $ACTIVE_CONFIG:"
        for entry in "${SERVICES[@]}"; do
            IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
            echo "  - $s_name ($s_unit)"
        done
        exit 1
    fi

    local resolved=$(resolve_service "$target")
    local entry=$(get_service_entry "$resolved" || true)
    if [[ -n "$entry" ]]; then
        IFS='|' read -r s_name s_unit s_port s_desc s_aliases <<< "$entry"
        echo -e "${CYAN}Streaming live logs for ${BOLD}$s_name${NC} ($s_unit)... (Press Ctrl+C to exit)${NC}"
        journalctl -u "$s_unit" -n 50 -f
    else
        echo -e "${RED}[!] Unknown service: $target${NC}"
        exit 1
    fi
}

cmd_init() {
    local target_file="./mgr.conf"
    if [[ -f "$target_file" ]]; then
        echo -e "${YELLOW}mgr.conf already exists in current directory.${NC}"
        exit 0
    fi

    cat << 'EOF' > "$target_file"
# ==============================================================================
# mgr configuration file
# Syntax: name = systemd_unit_name : port : description : aliases (optional)
# ==============================================================================

[services]
# Web & Proxy
caddy      = caddy.service           : 80,443   : Caddy Reverse Proxy   : web,proxy
# Backend APIs
api        = my-backend.service      : 8000     : Primary REST API      : backend,server
# Databases & Caches
redis      = redis-server.service    : 6379     : Redis Cache           : cache
postgres   = postgresql.service      : 5432     : PostgreSQL DB         : db,psql
EOF

    echo -e "${GREEN}✓ Created sample configuration at ${BOLD}$target_file${NC}"
    echo "Edit this file to include your systemd services, then run 'mgr' to manage them."
}

cmd_install_watchdog() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[ERROR] Root privileges required to install cron watchdog.${NC}"
        echo "Run: sudo mgr install-watchdog"
        exit 1
    fi

    local mgr_bin=$(command -v mgr || echo "/usr/local/bin/mgr")
    cat << EOF > "$CRON_FILE"
* * * * * root $mgr_bin -w >/dev/null 2>&1
EOF
    chmod 644 "$CRON_FILE"
    echo -e "${GREEN}✓ Watchdog cron job installed at $CRON_FILE (runs every 1 minute).${NC}"
    echo -e "Logs will be written to ${BOLD}$LOG_FILE${NC} when services auto-recover."
}

cmd_uninstall_watchdog() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[ERROR] Root privileges required to uninstall cron watchdog.${NC}"
        exit 1
    fi

    rm -f "$CRON_FILE"
    echo -e "${GREEN}✓ Watchdog cron job removed.${NC}"
}

show_help() {
    echo -e "${BOLD}mgr - Unified Systemd Service Manager & Auto-Healing Watchdog${NC} (v${VERSION})"
    echo ""
    echo -e "${BOLD}USAGE:${NC}"
    echo "  mgr [COMMAND] [OPTIONS] [SERVICES...]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo "  (no args)             Check all services, display health table, auto-heal dead ones"
    echo "  up, start, -r         Start or Restart specified services (or ALL if omitted)"
    echo "  down, stop, -s        Stop specified services (or ALL if omitted)"
    echo "  restart, -r           Restart specified services (or ALL if omitted)"
    echo "  kill, -k              Force kill (SIGKILL) specified services (or ALL if omitted)"
    echo "  logs, -l <service>    Live tail logs for a specific service"
    echo "  watchdog, -w          Silent watchdog check for cron/timer (auto-restarts dead ones)"
    echo "  init                  Create a sample mgr.conf in the current directory"
    echo "  install-watchdog      Install 1-minute auto-healing cron job"
    echo "  uninstall-watchdog    Remove auto-healing cron job"
    echo "  version, -v           Show version information"
    echo "  help, -h              Show this help message"
    echo ""
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo "  mgr                           # Check health & auto-heal all services"
    echo "  mgr restart api db            # Restart only 'api' and 'db' services"
    echo "  mgr stop caddy                # Stop caddy reverse proxy"
    echo "  mgr logs api                  # Tail live logs for 'api'"
    echo "  mgr -k redis                  # Force kill redis"
    echo ""
    echo -e "${BOLD}CONFIG SEARCH ORDER:${NC}"
    echo "  1. \$MGR_CONFIG (Environment variable)"
    echo "  2. ./mgr.conf (Current directory)"
    echo "  3. ~/.config/mgr/mgr.conf"
    echo "  4. /etc/mgr/mgr.conf"
    echo "  5. /etc/mgr.conf"
    echo ""
}

# ------------------------------------------------------------------------------
# Entry Point & Option Parsing
# ------------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
    load_services
    cmd_status_check true false
    exit 0
fi

case "$1" in
    init)
        cmd_init
        exit 0
        ;;
    install-watchdog)
        cmd_install_watchdog
        exit 0
        ;;
    uninstall-watchdog)
        cmd_uninstall_watchdog
        exit 0
        ;;
    version|-v|--version)
        echo "mgr version $VERSION"
        exit 0
        ;;
    help|-h|--help)
        show_help
        exit 0
        ;;
    -r|--restart|restart|up|start)
        shift
        load_services
        cmd_start_or_restart "$@"
        exit 0
        ;;
    -s|--shutdown|--stop|stop|down)
        shift
        load_services
        cmd_stop "$@"
        exit 0
        ;;
    -k|--kill|kill)
        shift
        load_services
        cmd_kill "$@"
        exit 0
        ;;
    -l|--logs|logs|log)
        shift
        load_services
        cmd_logs "$@"
        exit 0
        ;;
    -w|--watchdog|watchdog)
        load_services
        cmd_status_check true true
        exit 0
        ;;
    -c|--check|check|status)
        load_services
        cmd_status_check true false
        exit 0
        ;;
    *)
        # If user passes service name directly e.g. "mgr api" -> restart/status or unknown
        load_services
        cmd_start_or_restart "$@"
        exit 0
        ;;
esac
