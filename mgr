# ------------------------------------------------------------------------------
# Entry Point & Option Parsing
# ------------------------------------------------------------------------------
JSON_MODE="false"

# Check if global --json or -j flag is present
FILTERED_ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--json" || "$arg" == "-j" ]]; then
        JSON_MODE="true"
    else
        FILTERED_ARGS+=("$arg")
    fi
done

if [[ ${#FILTERED_ARGS[@]} -eq 0 ]]; then
    load_services
    cmd_status_check true false "$JSON_MODE"
    exit 0
fi

case "${FILTERED_ARGS[0]}" in
    init)
        cmd_init
        exit 0
        ;;
    install-watchdog)
        cmd_install_watchdog
        exit 0
        ;;
    uninstall-watchdog)
        cmd_uninstall_watchdog
        exit 0
        ;;
    install-completion)
        cmd_install_completion
        exit 0
        ;;
    completion)
        cmd_completion "${FILTERED_ARGS[1]:-bash}"
        exit 0
        ;;
    --list-services)
        cmd_list_services
        exit 0
        ;;
    mcp)
        cmd_mcp_server
        exit 0
        ;;
    version|-v|--version)
        if [[ "$JSON_MODE" == "true" ]]; then
            echo "{\"version\": \"$VERSION\"}"
        else
            echo "mgr version $VERSION"
        fi
        exit 0
        ;;
    help|-h|--help)
        show_help
        exit 0
        ;;
    -r|--restart|restart|up|start)
        load_services
        cmd_start_or_restart "${FILTERED_ARGS[@]:1}" "$([ "$JSON_MODE" == "true" ] && echo "--json")"
        exit 0
        ;;
    -s|--shutdown|--stop|stop|down)
        load_services
        cmd_stop "${FILTERED_ARGS[@]:1}" "$([ "$JSON_MODE" == "true" ] && echo "--json")"
        exit 0
        ;;
    -k|--kill|kill)
        load_services
        cmd_kill "${FILTERED_ARGS[@]:1}" "$([ "$JSON_MODE" == "true" ] && echo "--json")"
        exit 0
        ;;
    -l|--logs|logs|log)
        load_services
        cmd_logs "${FILTERED_ARGS[1]}" "${FILTERED_ARGS[2]}" "$([ "$JSON_MODE" == "true" ] && echo "--json")"
        exit 0
        ;;
    -w|--watchdog|watchdog)
        load_services
        cmd_status_check true true false
        exit 0
        ;;
    -c|--check|check|status)
        load_services
        cmd_status_check true false "$JSON_MODE"
        exit 0
        ;;
    *)
        load_services
        cmd_start_or_restart "${FILTERED_ARGS[@]}" "$([ "$JSON_MODE" == "true" ] && echo "--json")"
        exit 0
        ;;
esac
